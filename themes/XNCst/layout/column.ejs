<div class="content-body">
    <main class="color-text-content mt-16 lg:mt-20">
        <div class="w-full px-4 lg:px-8 py-8 tracking-wide">
            <div class="text-2xl lg:text-4xl font-semibold pb-2">
                <%= page.column.title %>（专栏）
            </div>
            <div class="text-lg lg:text-xl">
                <% if ( page.column.intro ) { %>
                <p><%- page.column.intro %></p>
                <% } else { %>
                <p>本专栏暂无介绍……</p>
                <% } %>
            </div>
            <div class="text-sm lg:text-base pt-2">
                共有 <%= page.articles.length %> 篇文章。
            </div>
        </div>
        <section class="w-full px-4 lg:px-8 py-8">
            <div class="archive-cards">
                <% for (let i = 0; i < page.articles.length; i++) { %>
                <a
                    class="archive-card-item grid grid-cols-[max-content_1fr] gap-4"
                    href="<%= url_for(page.articles[i].path) %>"
                >
                    <div
                        class="text-2xl lg:text-4xl font-semibold font-sans top-24 lg:top-28 h-fit"
                    >
                        <%= i + 1 %>.
                    </div>
                    <div>
                        <div class="text-2xl lg:text-4xl font-bold pb-1">
                            <%= page.articles[i].title %>
                        </div>
                        <div class="text-sm lg:text-base font-mono">
                            <% if ( page.articles[i].updated ) { %>
                            <time
                                datetime="<%= date(page.articles[i].updated || page.articles[i].date, 'YYYY-MM-DD') %>"
                            >
                                <%= date(page.articles[i].updated || page.articles[i].date, 'YY.MM.DD') %>
                                <%=
                            ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(page.articles[i].updated
                            || page.articles[i].date).day()] %>
                            </time>
                            <% } else { %>
                            <time
                                datetime="<%= date(page.articles[i].date, 'YYYY-MM-DD') %>"
                            >
                                <%= date(page.articles[i].date, 'YY.MM.DD') %>
                                <%=
                                ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(page.articles[i].date).day()]
                                %>
                            </time>
                            <% } %>
                        </div>
                    </div>
                </a>
                <% } %>
            </div>
        </section>
    </main>
</div>
