<!-- TITLE -->
<div class="aside-resize-top mt-16 lg:mt-20 border-b color-border color-text-content">
    <% if(page.header_callout) { page.header_callout.forEach(hc => { %>
    <div class="callout <%= hc.level %>">
        <div class="max-w-fit mx-auto">
            <div class="callout-title"><%= hc.title %></div>
            <!-- <p>
                由于该平台的建设时间较晚，故而此处发表的文章中分享的技术，不保证在此处的发布日期时仍然有效。
            </p>
            <p>
                原文
                <a
                    class="color-text-btn"
                    href="https://blog.csdn.net/weixin_74545283/article/details/132020069?spm=1011.2124.3001.6209"
                    target="_blank"
                    >Unity 在安卓平台使用 SQLite</a
                >
                由本人于 2025年2月12日 发布在 CSDN 平台。
            </p> -->
            <%- hc.content %>
        </div>
    </div>
    <% });} %>
    <div class="article-header">
        <div class="article-title"><%= page.title %></div>
        <!-- <img
                    class="article-cover"
                    src="./cover.png"
                    alt="article cover"
                /> -->
        <% if (page.tags && page.tags.length) { %>
        <div class="article-tags">
            <div class="px-2 border-r-2 color-border text-right">标签</div>
            <div class="article-tags-content">
                <% page.tags.each(function(tag) { %>
                <a class="color-text-btn" href="<%= url_for(tag.path) %>" target="_blank">
                    <div class="flex flex-row gap-1 items-center article-tag-item"><%= tag.name %></div>
                </a>
                <% }) %>
            </div>
        </div>
        <% } %>
        <script>
            const tagIcon =
                '<svg class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" height="1em" width="1em"><path d="M323.008 786.752c-52.928 0-96-43.072-96-96s43.072-96 96-96 96 43.072 96 96S375.936 786.752 323.008 786.752zM323.008 658.752c-17.632 0-32 14.336-32 32s14.368 32 32 32 32-14.336 32-32S340.64 658.752 323.008 658.752z" fill="currentColor"></path><path d="M416.096 927.072 284.224 927.072c-159.936 0-186.912-59.232-186.912-192l0-140.8c0-74.272 14.304-96.256 70.72-150.976l327.04-319.904c36.576-35.488 105.888-35.392 142.304-0.096l263.072 256.032c18.336 17.792 28.864 43.552 28.864 70.656 0 27.296-10.656 53.28-29.248 71.264l-290.016 294.592C544.544 880.416 497.216 927.072 416.096 927.072zM566.24 159.488c-10.496 0-20.16 3.52-26.528 9.696l-327.04 319.936c-49.952 48.48-51.36 54.528-51.36 105.152l0 140.8c0 110.272 8.352 128 122.912 128l131.872 0c52.672 0 83.744-28.48 148.992-92.8l26.656-26.144 263.232-268.256c6.784-6.592 10.336-15.808 10.336-25.888 0-9.888-3.424-18.88-9.472-24.736l-263.072-256.032C586.432 163.04 576.736 159.488 566.24 159.488z" fill="currentColor"></path> </svg>';
            const atis = document.querySelectorAll(".article-tag-item");
            atis.forEach(ati => ati.insertAdjacentHTML("afterbegin", tagIcon));
        </script>
        <% if (page.categories && page.categories.length) { %>
        <div class="article-categories">
            <div class="px-2 border-r-2 color-border text-right">分类</div>
            <div class="article-categories-content">
                <% var cates = []; page.categories.each(function(c) { cates.push(`<a class="color-text-btn" href="${url_for(c.path)}">${c.name}</a>`); }); %> <%- cates.join(' > ') %>
                <!-- <a class="color-text-btn" href="#">编程</a> >
                <a class="color-text-btn" href="#">游戏开发</a> -->
            </div>
        </div>
        <% } %>
        <% if (page.column && page.column.title) { %>
        <div class="article-columns">
            <div class="px-2 border-r-2 color-border text-right">专栏</div>
            <div class="px-2">
                <a class="color-text-btn" href="<%=url_for(page.column.path)%>"> <%= page.column.title %> </a>
            </div>
        </div>
        <% } %>
        <div class="article-publish_time">
            <div class="px-2 border-r-2 color-border text-right">创建日期</div>
            <div class="px-2">
                <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"> <%= date(page.date, 'YYYY年MM月DD日') %> 星期<%= ['日','一','二','三','四','五','六'][moment(page.date).day()] %> </time>
            </div>
        </div>
        <div class="article-expect_reading_time">
            <div class="px-2 border-r-2 color-border text-right">阅读时长</div>
            <div class="px-2"><%= min2read(page.content) %> 分钟</div>
        </div>
    </div>
</div>

<div class="content-body grid grid-cols-1 lg:grid-cols-[18rem_1fr] 2xl:grid-cols-[18rem_1fr_18rem]">
    <!-- LEFT ASIDE -->
    <div class="hidden lg:block border-r color-border">
        <div class="py-0 pt-0 sticky top-20">
            <aside class="aside-height-control-target flex flex-col text-sm">
                <div class="overflow-y-scroll grow" style="overscroll-behavior: contain">
                    <div class="pb-2 px-4">
                        <div class="uppercase tracking-wider text-center pt-4 pb-2 sticky top-0 border-b color-border color-text-primary color-layer-0 font-semibold">目录</div>
                        <div class="toc flex flex-col gap-4 w-full capitalize tracking-wide py-2 px-4"></div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
    <!-- TEXT CONTENT -->
    <main class="w-full min-w-0 break-words">
        <article class="text-body color-text-content pb-16 pt-0" tocSource>
            <!-- 直接包含生成器的生成内容，具体的结构由前端 JS 渲染 -->
            <%- page.content %>
        </article>
        <% if (page.column && page.column.title) { %>
        <div class="column-link px-8 py-8 border-t color-border">
            <div class="text-lg lg:text-xl font-semibold pb-2 lg:pb-4">
                本文属于 <% if ( page.column.prevColumnPost && page.column.nextColumnPost) { %>
                <a class="color-text-btn" href="<%= url_for(page.column.path) %>"> <%= page.column.title %> </a>
                <% } else { %>
                <%= page.column.title %>
                <% } %>
                专栏中的第
                <%= page.column.currentPostIndex + 1 %>
                篇
            </div>
            <div class="grid grid-cols-2 gap-2 lg:gap-8">
                <% if ( page.column.prevColumnPost ) { %>
                <a href="<%=url_for(page.column.prevColumnPost.path)%>" class="text-left color-text-btn border-2 rounded-md color-border">
                    <div class="grid grid-cols-[max-content_1fr] gap-2 lg:gap-4 py-1 pl-1">
                        <svg class="w-6 h-6 lg:w-7 lg:h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        <div class="grid grid-rows-[auto_auto] gap-1 lg:gap-2">
                            <div class="text-base lg:text-lg">上一篇文章</div>
                            <div class="text-sm lg:text-base"><%= page.column.prevColumnPost.title %></div>
                        </div>
                    </div>
                </a>
                <% } else { %>
                <a href="<%=url_for(page.column.path)%>" class="text-left color-text-btn border-2 rounded-md color-border">
                    <div class="grid grid-cols-[max-content_1fr] gap-2 lg:gap-4 py-1 pl-1">
                        <svg class="w-6 h-6 lg:w-7 lg:h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 12H5M12 19l-7-7 7-7"></path>
                        </svg>
                        <div class="grid grid-rows-[auto_auto] gap-1 lg:gap-2">
                            <div class="text-base lg:text-lg">专栏标题页</div>
                            <div class="text-sm lg:text-base"><%= page.column.title %></div>
                        </div>
                    </div>
                </a>
                <% } %>
                <% if ( page.column.nextColumnPost ) { %>
                <a href="<%=url_for(page.column.nextColumnPost.path)%>" class="text-right color-text-btn border-2 rounded-md color-border">
                    <div class="grid grid-cols-[1fr_max-content] gap-2 lg:gap-4 py-1 pr-1">
                        <div class="grid grid-rows-[auto_auto] gap-1 lg:gap-2">
                            <div class="text-base lg:text-lg">下一篇文章</div>
                            <div class="text-sm lg:text-base"><%= page.column.nextColumnPost.title %></div>
                        </div>
                        <svg class="w-6 h-6 lg:w-7 lg:h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </div>
                </a>
                <% } else { %>
                <a href="<%=url_for(page.column.path)%>" class="text-right color-text-btn border-2 rounded-md color-border">
                    <div class="grid grid-cols-[1fr_max-content] gap-2 lg:gap-4 py-1 pr-1">
                        <div class="grid grid-rows-[auto_auto] gap-1 lg:gap-2">
                            <div class="text-base lg:text-lg">专栏标题页</div>
                            <div class="text-sm lg:text-base"><%= page.column.title %></div>
                        </div>
                        <svg class="w-6 h-6 lg:w-7 lg:h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="M13 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </a>
                <% } %>
            </div>
        </div>
        <% } %>
    </main>
    <script src="<%- url_for('/js/preToCodeBlock.js') %>"></script>
    <script src="<%- url_for('/js/tocGenterator.js') %>"></script>
    <!-- RIGHT ASIDE -->
    <div class="hidden 2xl:block border-l color-border">
        <div class="py-0 pt-0 sticky top-20">
            <aside class="aside-height-control-target flex flex-col text-sm">
                <div class="overflow-y-scroll grow" style="overscroll-behavior: contain">
                    <% if (page.column && page.column.allPosts.length > 1 ) { %>
                    <div class="pb-2 px-4">
                        <div class="uppercase tracking-wider text-center pt-4 pb-2 sticky top-0 border-b color-border color-text-primary color-layer-0 font-semibold">
                            <a class="color-text-btn" href="<%= url_for(page.column.path) %>"> <%= page.column.title %> </a>
                            专栏
                        </div>
                        <div class="toc flex flex-col gap-4 w-full capitalize tracking-wide py-2 px-4">
                            <% page.column.allPosts.forEach(function (p) { %> <% if ( p.title === page.title ) { %>
                            <span class="text-textPrimary-light dark:text-textPrimary-dark font-semibold"> <%= p.title %> </span>
                            <% } else { %>
                            <a href="<%= url_for(p.path) %>" class="toc-item"> <%= p.title %> </a>
                            <% } %>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </aside>
        </div>
    </div>
</div>
