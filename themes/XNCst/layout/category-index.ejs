<div class="content-body">
    <main class="color-text-content mt-16 lg:mt-20">
        <div class="w-full px-4 lg:px-8 py-8 tracking-wide">
            <div class="text-2xl lg:text-4xl font-semibold pb-2">分类主页</div>
            <div class="text-lg lg:text-xl">
                <p>暂没有直接隶属于本分类的文章……</p>
                <p>
                    这是分类的根目录，您可以访问以下子链接以查看子分类和文章。
                </p>
            </div>
            <% if ( page.categoryTopNodes.length > 0 ) { %>
            <div class="flex flex-col gap-4 py-2 text-lg lg:text-xl">
                <% page.categoryTopNodes.forEach(function(c) { %>
                <a class="color-text-btn" href="<%= url_for(c.path) %>">
                    <div
                        class="grid grid-cols-[max-content_1fr] gap-2 items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="1em"
                            height="1em"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                        <span>
                            <%= c.name %>
                            <span class="font-mono text-sm lg:text-base"
                                >(<%= c.length %>)</span
                            >
                        </span>
                    </div>
                </a>
                <% }) %>
            </div>
            <% } %>
        </div>
    </main>
</div>
