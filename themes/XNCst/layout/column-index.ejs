<div class="content-body">
    <main class="color-text-content mt-16 lg:mt-20">
        <div class="column-info w-full px-4 lg:px-8 py-8 tracking-wide">
            <div class="text-2xl lg:text-4xl font-semibold pb-2">专栏总览</div>
        </div>
        <div class="w-full px-4 lg:px-8 py-8">
            <div class="archive-cards">
                <% page.columns.forEach(function (c) {%>
                <a
                    class="archive-card-item tracking-wide flex flex-col gap-2"
                    href="<%= url_for(c.path) %>"
                >
                    <div class="text-2xl lg:text-4xl font-bold pb-1">
                        <%= c.title %>
                    </div>
                    <!-- <div class="text-sm lg:text-base">
                        本专栏为作者在研究（游玩）Unity
                        引擎的时候遇到的问题的集合。
                    </div> -->
                    <% if ( c.intro ) { %>
                    <div class="text-lg lg:text-xl"><%- c.intro %></div>
                    <% } %>
                    <div class="text-sm lg:text-base">
                        最近更新于
                        <time
                            datetime="<%= date(c.updatedTime, 'YYYY-MM-DD') %>"
                        >
                            <%= date(c.updatedTime, 'YYYY年MM月DD日') %>
                            星期<%=
                            ['日','一','二','三','四','五','六'][moment(c.updatedTime).day()]
                            %>
                        </time>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
    </main>
</div>
