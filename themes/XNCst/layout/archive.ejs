<% 
var posts = site.posts.sort('updated', -1); 
var yearGroups = {};
posts.each(function(post) {
    var year = (post.updated||post.date).year();
    if (!yearGroups[year]) {
        yearGroups[year] = [];
    }
    yearGroups[year].push(post);
});
var years = Object.keys(yearGroups).sort(function(a, b) {
    return b - a;
});
%>
<div class="content-body">
    <!-- CONTENT -->
    <main class="color-text-content mt-16 lg:mt-20">
        <div class="column-info w-full px-4 lg:px-8 py-8 tracking-wide">
            <div class="text-2xl lg:text-4xl font-semibold pb-2">归档</div>
            <!-- <div class="text-lg lg:text-xl">
                <p>
                    本站现存
                    篇文章，希望您在这里可以找到感兴趣的内容。
                </p>
            </div> -->
            <div class="text-sm lg:text-base pt-2">
                共有 <%= site.posts.length %> 篇文章。
            </div>
        </div>
        <% years.forEach(function(year) { %>
        <section
            class="w-full px-4 lg:px-8 py-8 grid grid-cols-[max-content_1fr] gap-4 lg:gap-8"
        >
            <div
                class="text-2xl lg:text-4xl font-semibold font-sans sticky top-24 lg:top-28 h-fit"
            >
                <%= year %>
            </div>
            <div class="archive-cards">
                <% yearGroups[year].forEach(function(post) { %>
                <a
                    class="archive-card-item flex flex-col gap-2"
                    href="<%= url_for(post.path) %>"
                >
                    <div class="text-2xl lg:text-4xl font-bold pb-1">
                        <%= post.title %>
                    </div>
                    <div class="text-sm lg:text-base font-mono">
                        <% if ( post.updated ) { %>
                        <time
                            datetime="<%= date(post.updated || post.date, 'YYYY-MM-DD') %>"
                        >
                            <%= date(post.updated || post.date, 'YY.MM.DD') %>
                            <%=
                            ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(post.updated
                            || post.date).day()] %>
                        </time>
                        <% } else { %>
                        <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>">
                            <%= date(post.date, 'YY.MM.DD') %> <%=
                            ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(post.date).day()]
                            %>
                        </time>
                        <% } %>
                    </div>
                </a>
                <% }) %>
            </div>
        </section>
        <% }) %>
    </main>
</div>
