<!-- BOTTOM -->
<footer class="pt-8 pb-4 px-4 h-auto border-t color-border w-full flex flex-col justify-center gap-8 aside-resize-bottom">
    <div class="w-full h-full flex flex-col md:flex-row justify-between items-start md:items-center gap-4 md:gap-8">
        <div class="color-text-secondary text-sm">
            <div>本站游览 <span id="busuanzi_value_site_pv" class="font-mono"></span> 次</div>
            <% if ( page.layout === 'post' ) { %>
            <div>本文游览 <span id="busuanzi_value_page_pv" class="font-mono"></span> 次</div>
            <% } %>
        </div>
        <!-- THEME BUTTON 此 classlist 受代码控制！ -->
        <div class="flex flex-row gap-1 p-1 w-full md:w-auto border color-border rounded-full antialiased" role="radiogroup">
            <button class="theme-btn" role="radio" type="button" aria-checked="false" data-theme="light">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.9 4.9l-1.4-1.4M20.5 20.5l-1.4-1.4M4.9 19.1l-1.4 1.4M20.5 3.5l-1.4 1.4" />
                </svg>
                <span class="inline md:hidden"> Light </span>
            </button>
            <button class="theme-btn active" role="radio" type="button" aria-checked="true" data-theme="system">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="14" rx="2" />
                    <line x1="2" x2="22" y1="21" y2="21" />
                </svg>
                <span class="inline md:hidden"> System </span>
            </button>
            <button class="theme-btn" role="radio" type="button" aria-checked="false" data-theme="dark">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
                </svg>
                <span class="inline md:hidden"> Dark </span>
            </button>
        </div>
    </div>
    <!-- COPYRIGHT ANNOUNCEMENT -->
    <small class="color-text-secondary font-mono text-xs text-center"> Copyright © 2026 XINICOM (YiCheng ZHOU). All Rights Reserved. </small>
</footer>
