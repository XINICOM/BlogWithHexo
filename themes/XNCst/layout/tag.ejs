<% 
    var posts = page.posts.sort('updated', -1); 
    var yearGroups = {};
    posts.each(function(post) {
        var year = (post.updated||post.date).year();
        if (!yearGroups[year]) {
            yearGroups[year] = [];
        }
        yearGroups[year].push(post);
    });
    var years = Object.keys(yearGroups).sort(function(a, b) {
        return b - a;
    });
%>
<div class="content-body">
    <!-- CONTENT -->
    <main class="color-text-content mt-16 lg:mt-20">
        <div class="column-info w-full px-4 lg:px-8 py-8 tracking-wide">
            <div
                class="text-2xl lg:text-4xl font-semibold py-1 items-center grid grid-cols-[auto_1fr] gap-2 article-tag-item"
            >
                <%= page.tag.name %>
            </div>
            <div class="text-lg lg:text-xl">
                <% if (page.tag.intro) { %>
                <p><%- page.tag.intro %></p>
                <% } else { %>
                <p>本标签暂无介绍……</p>
                <% } %>
            </div>
            <div class="flex flex-col gap-4 py-2 text-lg lg:text-xl">
                <a class="color-text-btn" href="<%= url_for('/tags/') %>">
                    <div
                        class="grid grid-cols-[max-content_1fr] gap-2 items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="1em"
                            height="1em"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M19 12H5M12 19l-7-7 7-7"></path>
                        </svg>
                        返回至标签总览
                    </div>
                </a>
            </div>
        </div>
        <% years.forEach(function(year) { %>
        <section
            class="w-full px-4 lg:px-8 py-8 grid grid-cols-[max-content_1fr] gap-4 lg:gap-8"
        >
            <div
                class="text-2xl lg:text-4xl font-semibold font-sans sticky top-24 lg:top-28 h-fit"
            >
                <%= year %>
            </div>
            <div class="archive-cards">
                <% yearGroups[year].forEach(function(p) { %>
                <a
                    class="archive-card-item flex flex-col gap-2"
                    href="<%= url_for(p.path) %>"
                >
                    <div class="text-2xl lg:text-4xl font-bold pb-1">
                        <%= p.title %>
                    </div>
                    <div class="text-sm lg:text-base font-mono">
                        <% if ( p.updated ) { %>
                        <time
                            datetime="<%= date(p.updated || p.date, 'YYYY-MM-DD') %>"
                        >
                            <%= date(p.updated || p.date, 'YY.MM.DD') %>
                            <%=
                            ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(p.updated
                            || p.date).day()] %>
                        </time>
                        <% } else { %>
                        <time datetime="<%= date(p.date, 'YYYY-MM-DD') %>">
                            <%= date(p.date, 'YY.MM.DD') %> <%=
                            ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(p.date).day()]
                            %>
                        </time>
                        <% } %>
                    </div>
                </a>
                <% }) %>
            </div>
        </section>
        <% }) %>
    </main>
</div>
<script>
    const tagIcon =
        '<svg class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" height="1em" width="1em"><path d="M323.008 786.752c-52.928 0-96-43.072-96-96s43.072-96 96-96 96 43.072 96 96S375.936 786.752 323.008 786.752zM323.008 658.752c-17.632 0-32 14.336-32 32s14.368 32 32 32 32-14.336 32-32S340.64 658.752 323.008 658.752z" fill="currentColor"></path><path d="M416.096 927.072 284.224 927.072c-159.936 0-186.912-59.232-186.912-192l0-140.8c0-74.272 14.304-96.256 70.72-150.976l327.04-319.904c36.576-35.488 105.888-35.392 142.304-0.096l263.072 256.032c18.336 17.792 28.864 43.552 28.864 70.656 0 27.296-10.656 53.28-29.248 71.264l-290.016 294.592C544.544 880.416 497.216 927.072 416.096 927.072zM566.24 159.488c-10.496 0-20.16 3.52-26.528 9.696l-327.04 319.936c-49.952 48.48-51.36 54.528-51.36 105.152l0 140.8c0 110.272 8.352 128 122.912 128l131.872 0c52.672 0 83.744-28.48 148.992-92.8l26.656-26.144 263.232-268.256c6.784-6.592 10.336-15.808 10.336-25.888 0-9.888-3.424-18.88-9.472-24.736l-263.072-256.032C586.432 163.04 576.736 159.488 566.24 159.488z" fill="currentColor"></path> </svg>';
    const atis = document.querySelectorAll(".article-tag-item");
    atis.forEach((ati) => ati.insertAdjacentHTML("afterbegin", tagIcon));
</script>
