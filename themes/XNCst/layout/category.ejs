<!-- prettier-ignore -->
<% 
    var currentNode;
    for (const c of page.allCategories) {        
        const n = c.getNodeWithName(page.category);
        if (n) {
            currentNode = n; 
            break;
        }
    }
    const parents = currentNode?.getParents();
%>
<div
    class="aside-resize-top mt-16 lg:mt-20 border-b color-border color-text-content text-center"
>
    <div class="callout caution">
        <div class="max-w-fit mx-auto">
            <div class="callout-title">这是 category.ejs</div>
            <p>
                鉴于本网站还未完工，一般本页面不应该使用 category.ejs 来生产。
            </p>
            <p><%= page.category %></p>
            <% if(parents) parents.forEach(function(p) { %>
            <a href="<%= url_for(p.path) %>"><%= p.name %></a>
            <% }) %>
        </div>
    </div>
</div>

<div class="content-body">
    <!-- CONTENT -->
    <main class="color-text-content">
        <div class="column-info w-full px-4 lg:px-8 py-8 tracking-wide">
            <div class="text-2xl lg:text-4xl font-semibold pb-2">分类主页</div>
            <div class="text-lg lg:text-xl">
                <p>暂没有直接隶属于本分类的文章。</p>
                <p>
                    这是分类的根目录，您可以访问以下子链接以查看子分类和文章。
                </p>
            </div>
            <div class="flex flex-col gap-4 py-2 text-lg lg:text-xl">
                <a class="color-text-btn" href="">
                    <div
                        class="grid grid-cols-[max-content_1fr] gap-2 items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="1em"
                            height="1em"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M5 12h14"></path>
                            <path d="M13 5l7 7-7 7"></path>
                        </svg>
                        Unity 开发
                    </div>
                </a>
            </div>
        </div>
        <section
            class="w-full px-4 lg:px-8 py-8 grid grid-cols-[max-content_1fr] gap-4 lg:gap-8"
        >
            <div
                class="text-2xl lg:text-4xl font-semibold font-sans sticky top-24 lg:top-28 h-fit"
            >
                2026
            </div>
            <div class="archive-cards">
                <a
                    class="archive-card-item"
                    href="./../articles/2026/07/12/testarticle1/"
                >
                    <div class="text-2xl lg:text-4xl font-bold pb-1">
                        Unity 在安卓平台使用 SQLite
                    </div>
                    <div class="text-sm lg:text-base">2026年7月21日星期二</div>
                </a>
                <a
                    class="archive-card-item"
                    href="./../articles/2026/07/12/testarticle1/"
                >
                    <div class="text-2xl lg:text-4xl font-bold pb-1">
                        Unity 在安卓平台使用 SQLite
                    </div>
                    <div class="text-sm lg:text-base">2026年7月21日星期二</div>
                </a>
                <a
                    class="archive-card-item"
                    href="./../articles/2026/07/12/testarticle1/"
                >
                    <div class="text-2xl lg:text-4xl font-bold pb-1">
                        Unity 在安卓平台使用 SQLite
                    </div>
                    <div class="text-sm lg:text-base">2026年7月21日星期二</div>
                </a>
            </div>
        </section>
    </main>
</div>
