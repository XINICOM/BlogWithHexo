<% 
    var currentNode;
    for (const c of page.allCategories) {        
        const n = c.getNodeWithName(page.category);
        if (n) {
            currentNode = n; 
            break;
        }
    }
    const parents = currentNode?.getParents();
    
    var originPosts = currentNode?.posts?.sort('updated', -1); 
    var posts = [];
    originPosts.each(function (op) {
        if( op?.categories?.data?.at(-1)?.name === page.category ) posts.push(op);
    });
    var yearGroups = {};
    if(posts)
        posts.forEach(function(post) {
            var year = (post.updated||post.date).year();
            if (!yearGroups[year]) {
                yearGroups[year] = [];
            }
            yearGroups[year].push(post);
        });
    var years;
    if(posts)
        years = Object.keys(yearGroups).sort(function(a, b) {
            return b - a;
        });
%>
<div class="content-body">
    <main class="color-text-content mt-16 lg:mt-20">
        <div class="w-full px-4 lg:px-8 py-8 tracking-wide">
            <div class="text-2xl lg:text-4xl font-semibold pb-2">
                <%= page.category %>（分类）
            </div>
            <div class="text-lg lg:text-xl">
                <% if (currentNode?.intro) { %>
                <p><%- currentNode?.intro %></p>
                <% } else { %>
                <p>本分类暂无介绍……</p>
                <% } %>
                <% if (!posts) { %>
                <p>暂没有直接隶属于本分类的文章。</p>
                <% } %>
            </div>

            <% if (page.rootPath) { %>
            <div class="flex flex-col gap-4 py-2 text-lg lg:text-xl">
                <a class="color-text-btn" href="<%= url_for(page.rootPath) %>">
                    <div
                        class="grid grid-cols-[max-content_1fr] gap-2 items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="1em"
                            height="1em"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M19 12H5M12 19l-7-7 7-7"></path>
                        </svg>
                        返回分类主页
                    </div>
                </a>
            </div>
            <% } %>
            <%
            if(page.rootPath&&(currentNode.children.length>0||parents?.length>0)){
            %>
            <hr />
            <% } %>
            <% if (parents?.length > 0) { %>
            <div class="flex flex-col gap-4 py-2 text-lg lg:text-xl">
                <a
                    class="color-text-btn"
                    href="<%= url_for(parents[0].path) %>"
                >
                    <div
                        class="grid grid-cols-[max-content_1fr] gap-2 items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="1em"
                            height="1em"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        <%= parents[0].name %>
                    </div>
                </a>
            </div>
            <% } %>
            <% if ( currentNode.children.length > 0 && parents?.length > 0 ) {
            %>
            <hr />
            <% } %>
            <% if ( currentNode.children.length > 0 ) { %>
            <div class="flex flex-col gap-4 py-2 text-lg lg:text-xl">
                <% currentNode.children.forEach(function(c) { %>
                <a class="color-text-btn" href="<%= url_for(c.path) %>">
                    <div
                        class="grid grid-cols-[max-content_1fr] gap-2 items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="1em"
                            height="1em"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                        <span>
                            <%= c.name %>
                            <span class="font-mono text-sm lg:text-base"
                                >(<%= c.length %>)</span
                            >
                        </span>
                    </div>
                </a>
                <% }) %>
            </div>
            <% } %>
        </div>
        <% if (posts) years.forEach(function(year) { %>
        <section
            class="w-full px-4 lg:px-8 py-8 grid grid-cols-[max-content_1fr] gap-4 lg:gap-8"
        >
            <div
                class="text-2xl lg:text-4xl font-semibold font-sans sticky top-24 lg:top-28 h-fit"
            >
                <%= year %>
            </div>
            <div class="archive-cards">
                <% yearGroups[year].forEach(function(p) { %>
                <a
                    class="archive-card-item flex flex-col gap-2"
                    href="<%= url_for(p.path) %>"
                >
                    <div class="text-2xl lg:text-4xl font-bold pb-1">
                        <%= p.title %>
                    </div>
                    <div class="text-sm lg:text-base font-mono">
                        <% if ( p.updated ) { %>
                        <time
                            datetime="<%= date(p.updated || p.date, 'YYYY-MM-DD') %>"
                        >
                            <%= date(p.updated || p.date, 'YY.MM.DD') %>
                            <%=
                            ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(p.updated
                            || p.date).day()] %>
                        </time>
                        <% } else { %>
                        <time datetime="<%= date(p.date, 'YYYY-MM-DD') %>">
                            <%= date(p.date, 'YY.MM.DD') %> <%=
                            ['Sun.','Mon.','Tue.','Wed.','Thu.','Fri.','Sat.'][moment(p.date).day()]
                            %>
                        </time>
                        <% } %>
                    </div>
                </a>
                <% }) %>
            </div>
        </section>
        <% }) %>
    </main>
</div>
